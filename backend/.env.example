# =============================================================================
# DITASH Human+ — Variables de entorno del backend
# Copiar a ".env" y completar con valores reales. NUNCA versionar el ".env".
# =============================================================================

NODE_ENV=development
PORT=4000

# --- Base de datos MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ditash
DB_USER=ditash_app
DB_PASSWORD=cambia_esta_clave
DB_SSL=false
# Solo si DB_SSL=true: pon "false" para aceptar certificados autofirmados
# (ej. algunos proveedores gestionados o un MySQL propio sin CA pública).
DB_SSL_REJECT_UNAUTHORIZED=true

# --- JWT / Sesiones ---
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=reemplaza_con_64_bytes_aleatorios
JWT_REFRESH_SECRET=reemplaza_con_otros_64_bytes_aleatorios
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Cifrado de secretos MFA en reposo (AES-256-GCM), 32 bytes en hex ---
MFA_ENCRYPTION_KEY=reemplaza_con_32_bytes_en_hex

# --- CSRF ---
CSRF_SECRET=reemplaza_con_32_bytes_aleatorios

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Cookies ---
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# strict (por defecto, más seguro) | lax | none (none EXIGE COOKIE_SECURE=true)
COOKIE_SAMESITE=strict

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=5

# --- Almacenamiento de archivos (expediente, certificados) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# --- Correo transaccional (recuperación de contraseña, bienvenida, citas) ---
# Todas estas variables son OPCIONALES: si dejas SMTP_HOST vacío, el sistema
# sigue funcionando por completo — los correos se registran en el log del
# servidor en vez de enviarse (útil en desarrollo local sin cuenta SMTP).
# API gratuita sugerida: Brevo (Sendinblue) - 300 correos/día gratis - https://www.brevo.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DITASH Human+ <no-reply@ditash.com>

# URL pública del frontend, usada para construir el enlace de recuperación
# de contraseña en el correo (nunca se confía en el header Host).
FRONTEND_URL=http://localhost:5173

# --- Videollamadas ---
# Canal "videollamada_interna" (Jitsi): no requiere configuración ni API key,
# se usa https://meet.jit.si (gratuito y público) generando una sala aleatoria
# de 24 caracteres por cita. Ver backend/src/utils/videollamada.js.

# Canal "meet" (Google Meet real): OPCIONAL. Sin estas 3 variables, elegir
# "Google Meet" al agendar sigue funcionando pero cae automáticamente a
# Jitsi. Para activarlo:
#   1. Ve a https://console.cloud.google.com/ y crea un proyecto (o usa uno existente).
#   2. En "APIs y servicios > Biblioteca", activa "Google Calendar API".
#   3. En "APIs y servicios > Pantalla de consentimiento OAuth": elige "Externo"
#      (o "Interno" si tienes Google Workspace), completa nombre de la app y
#      correo de soporte. En "Usuarios de prueba" agrega la cuenta de Google
#      que vas a conectar (mientras la app no esté "publicada").
#   4. En "APIs y servicios > Credenciales > Crear credenciales > ID de cliente
#      de OAuth", tipo "Aplicación web". En "URIs de redirección autorizados"
#      agrega EXACTAMENTE el valor de GOOGLE_REDIRECT_URI de abajo (con tu
#      dominio real en producción).
#   5. Copia el Client ID y el Client Secret aquí abajo.
#   6. Reinicia el backend, entra como SUPER_ADMIN a Admin > Integraciones y
#      pulsa "Conectar cuenta de Google" (usa la misma cuenta que agregaste
#      como "usuario de prueba" en el paso 3).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/admin/integraciones/google/callback
